# =============================================================================
# Pi Project - 車載安全監控系統 環境變數配置
# 上次日期: 2025-08-31
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudinary 雲端服務配置 (必填)
# 請到 https://cloudinary.com 註冊帳號並獲取以下資訊
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="Root"
CLOUDINARY_API_KEY="762188189864114"
CLOUDINARY_API_SECRET="Sa-ugP56G1jAh9vrZa2MIsD2_VI"

# -----------------------------------------------------------------------------
# 攝影機硬體配置
# 根據您的硬體設定調整攝影機索引
# -----------------------------------------------------------------------------

# 內鏡頭 (駕駛員監控)
INTERNAL_CAMERA_INDEX=0

# 外鏡頭 (ADAS 分析)
EXTERNAL_CAMERA_INDEX=1

# -----------------------------------------------------------------------------
# GPIO 硬體配置 (Raspberry Pi 專用)
# 如果在 macOS/Linux 上測試，請設定 ENABLE_GPIO=False
# -----------------------------------------------------------------------------

# GPIO 接腳定義
LEFT_TURN_PIN=18
RIGHT_TURN_PIN=19
SPEED_SENSOR_PIN=20

# 是否啟用 GPIO 功能
ENABLE_GPIO=False

# -----------------------------------------------------------------------------
# 系統配置
# -----------------------------------------------------------------------------

# 日誌等級 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 除錯模式 (True/False)
DEBUG_MODE=False

# -----------------------------------------------------------------------------
# 可選配置 (進階用戶)
# -----------------------------------------------------------------------------

# 資料庫配置 (可選，預設使用 SQLite)
# DATABASE_URL=sqlite:///data/system.db

# 外部 API 配置 (可選)
# EXTERNAL_API_KEY=your_external_api_key
# EXTERNAL_API_ENDPOINT=https://api.example.com

# 郵件通知配置 (可選)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Webhook 配置 (可選)
# WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# -----------------------------------------------------------------------------
# 說明與範例
# -----------------------------------------------------------------------------

# Cloudinary 設定說明:
# 1. 註冊 Cloudinary 免費帳號: https://cloudinary.com
# 2. 登入後到 Dashboard 頁面
# 3. 複製 Cloud name, API Key, API Secret
# 4. 替換上面的 your_xxx_here 部分

# 攝影機索引說明:
# - 通常第一個 USB 攝影機是索引 0
# - 如果有內建攝影機，USB 攝影機可能是索引 1, 2
# - 可執行 python scripts/test_cameras.py 來測試

# GPIO 設定說明:
# - 只有在 Raspberry Pi 上才需要啟用 GPIO
# - 在開發環境 (macOS/Linux) 請設定 ENABLE_GPIO=False
# - GPIO 接腳號碼使用 BCM 編號方式

# -----------------------------------------------------------------------------
# 環境特定配置範例
# -----------------------------------------------------------------------------

# 開發環境 (macOS/Linux)
# ENABLE_GPIO=False
# LOG_LEVEL=DEBUG
# DEBUG_MODE=True

# 生產環境 (Raspberry Pi)
# ENABLE_GPIO=True
# LOG_LEVEL=INFO
# DEBUG_MODE=False

# 測試環境
# LOG_LEVEL=DEBUG
# DEBUG_MODE=True
# CLOUDINARY_CLOUD_NAME=test_cloud